            "custom_liquid": "{% if request.page_type == 'product' %}\n  <div id=\"currency-notice\" class=\"currency-notice\" aria-live=\"polite\">\n    Esta pieza se elabora bajo pedido. El tiempo estimado de entrega  es de 3 a 4 semanas hábiles.\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', function() {\n      var notice = document.getElementById('currency-notice');\n      if (!notice) return;\n\n      // intenta varias ubicaciones típicas de precio según el tema\n      var targets = [\n        document.querySelector('product-info .price'),\n        document.querySelector('.product__info-container .price'),\n        document.querySelector('.product__info-wrapper .price'),\n        document.querySelector('[data-product-price]'),\n        document.querySelector('.product__price'),\n        document.querySelector('.price')\n      ].filter(Boolean);\n\n      var priceEl = targets.length ? targets[0] : null;\n      if (priceEl && priceEl.parentNode) {\n        // inserta el aviso justo después del precio\n        priceEl.parentNode.insertBefore(notice, priceEl.nextSibling);\n      }\n    });\n  </script>\n\n  <style>\n    .currency-notice{\n      font-size: 15px; /* ~14px */\n      line-height: 1.4;\n      opacity: 1;\n     margin-top:30px;\n    }\n  </style>\n{% endif %}"
