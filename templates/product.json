        "custom_liquid_kqxmtd": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<script>\n(function () {\n  function setAttrs(v) {\n    if (!v) return;\n    v.muted = true;\n    v.loop = true;\n    v.autoplay = true;\n    v.playsInline = true;\n    v.setAttribute('muted','');\n    v.setAttribute('loop','');\n    v.setAttribute('autoplay','');\n    v.setAttribute('playsinline','');\n    v.setAttribute('webkit-playsinline','');\n    v.removeAttribute('controls');\n  }\n  function tryPlay(v){ if(v) v.play()?.catch(()=>{}); }\n  function tryPause(v){ if(v) v.pause?.(); }\n\n  // Encuentra la galería (Dawn)\n  function getGallery(){\n    return document.querySelector('media-gallery, [id^=\"MediaGallery\"], .product__media');\n  }\n\n  function getAllVideos() {\n    // videos nativos (MP4) dentro de la galería\n    return document.querySelectorAll('media-gallery video, [id^=\"MediaGallery\"] video, .product__media video');\n  }\n\n  function getActiveVideo() {\n    // distintos selectores según versión de Dawn\n    return (\n      document.querySelector('media-gallery .slider__slide[aria-hidden=\"false\"] video') ||\n      document.querySelector('[id^=\"MediaGallery\"] .is-active video') ||\n      document.querySelector('.product__media-item--active video')\n    );\n  }\n\n  function enhanceAll() {\n    var vids = getAllVideos();\n    vids.forEach(setAttrs);\n    playOnlyActive();\n  }\n\n  function playOnlyActive() {\n    var vids = getAllVideos();\n    var active = getActiveVideo();\n    vids.forEach(v => (v === active ? tryPlay(v) : tryPause(v)));\n  }\n\n  function observeSlideChanges(gallery){\n    if (!gallery) return;\n    // 1) Cambios de aria-hidden al pasar de slide\n    var mo = new MutationObserver(function(){\n      playOnlyActive();\n    });\n    mo.observe(gallery, { subtree: true, attributes: true, attributeFilter: ['aria-hidden','class','hidden'] });\n\n    // 2) Clicks en miniaturas\n    document.addEventListener('click', function(e){\n      if (e.target.closest('[data-thumbnail], .thumbnail-list__item, button[aria-controls*=\"MediaGallery\"]')) {\n        setTimeout(playOnlyActive, 120);\n      }\n    }, true);\n\n    // 3) Reintentos típicos móvil/iOS\n    ['touchstart','pointerdown','scroll'].forEach(ev=>{\n      window.addEventListener(ev, ()=> playOnlyActive(), { once:true, passive:true });\n    });\n\n    document.addEventListener('visibilitychange', function(){\n      if (!document.hidden) playOnlyActive();\n    });\n\n    // 4) Reproduce solo cuando el slide está visible en viewport\n    if ('IntersectionObserver' in window) {\n      var io = new IntersectionObserver((entries)=>{\n        entries.forEach((entry)=>{\n          if (entry.isIntersecting) {\n            setAttrs(entry.target);\n            tryPlay(entry.target);\n          } else {\n            tryPause(entry.target);\n          }\n        });\n      }, { threshold: 0.5 });\n      getAllVideos().forEach(v => io.observe(v));\n    }\n  }\n\n  function init(){\n    var gallery = getGallery();\n    if (!gallery) return;\n    enhanceAll();\n    observeSlideChanges(gallery);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>"
          }
        },
