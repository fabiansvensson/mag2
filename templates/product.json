            "custom_liquid": "<script>\n  (function () {\n    function openTidio() {\n      if (window.tidioChatApi && typeof window.tidioChatApi.open === 'function') {\n        window.tidioChatApi.open();\n      }\n    }\n\n    function bindChatToAll() {\n      var links = Array.from(document.querySelectorAll('a, button, span'));\n\n      links.forEach(function (el) {\n        var text = el.textContent.trim().toLowerCase();\n        if (['escríbenos', 'chat en vivo', 'contáctanos'].includes(text)) {\n          el.style.cursor = 'pointer';\n          el.addEventListener('click', function (e) {\n            e.preventDefault();\n            e.stopPropagation();\n            if (window.tidioChatApi) {\n              openTidio();\n            } else {\n              document.addEventListener('tidioChat-ready', openTidio, { once: true });\n            }\n          });\n        }\n      });\n    }\n\n    document.addEventListener('DOMContentLoaded', bindChatToAll);\n  })();\n</script>"
          }
